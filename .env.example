# Copy to .env in the project root. Never commit real keys.
LLM_PROVIDER=deepseek
LLM_API_KEY=replace-with-your-key
# A Chat Completions endpoint with native tools/tool_calls support.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
APP_API_TOKEN=local-demo-token-change-me
AGENT_MODEL_CALL_LIMIT=8
AGENT_TOOL_CALL_LIMIT=12
AGENT_RECURSION_LIMIT=100
APP_REQUEST_TIMEOUT=90
APP_MAX_CONCURRENT=4
APP_MAX_SESSIONS=100
APP_MAX_TURNS=20

